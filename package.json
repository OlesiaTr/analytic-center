{
  "name": "analytic-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check .",
    "check-lint": "eslint .",
    "format": "prettier --write .",
    "fix": "eslint . --fix && prettier --write .",
    "test-all": "npm run check-format && npm run check-lint && npm run check-types && npm run check-images && npm run build",
    "prepare": "husky",
    "screenshots": "node scripts/screenshots.mts",
    "screenshots:diff": "node scripts/visual-diff.mts",
    "images:dimensions": "node scripts/image-dimensions.mts",
    "check-images": "node scripts/image-dimensions.mts --check"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "clsx": "2.1.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "swiper": "14.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-tailwindcss": "4.4.0",
    "husky": "9.1.7",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
