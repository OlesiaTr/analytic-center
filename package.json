{
  "name": "analytic-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "sanity schema extract --path sanity/schema.json --enforce-required-fields --force && sanity typegen generate",
    "lint": "eslint .",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check .",
    "check-lint": "eslint .",
    "format": "prettier --write .",
    "fix": "eslint . --fix && prettier --write .",
    "test-all": "npm run check-format && npm run check-lint && npm run check-types && npm test && npm run build && npm run test:e2e",
    "prepare": "husky",
    "screenshots": "node scripts/screenshots.mts",
    "screenshots:diff": "node scripts/visual-diff.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sanity/client": "8.11.0",
    "@sanity/icons": "5.2.3",
    "@sanity/image-url": "2.1.1",
    "@sanity/vision": "6.20.0",
    "clsx": "2.1.1",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-sanity": "13.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "6.20.0",
    "styled-components": "6.6.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@sanity/webhook": "4.0.4",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-tailwindcss": "4.4.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
