# Copy to .env.local (or `vercel env pull .env.local`). Never commit real values.

# Sanity project and dataset: public (the dataset is public-read), so a fresh
# clone runs against the live content as is
NEXT_PUBLIC_SANITY_PROJECT_ID=xczp8pdn
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: canonical origin for metadata, sitemap, JSON-LD and llms.txt
# (defaults to https://acmhs.in.ua/)
NEXT_PUBLIC_SITE_URL=

# Webhook secret shared with the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# Only for scripts/sanity-translations.mts apply (Editor token, never in the browser)
SANITY_API_WRITE_TOKEN=
